APP_MODE=simulation
MEET_URL=
BOT_DISPLAY_NAME=仮想点呼
ACTIVE_SCENARIO_ID=1
DATABASE_PATH=/data/tenko.db
ADMIN_TOKEN=change-me
CHROME_GUI_PASSWORD=generate-a-strong-random-password
# PCごとに一意の値を設定する。主系はpriority 100、待機系は50を目安にする。
CLUSTER_NODE_ID=primary-pc
CLUSTER_NODE_NAME=Primary PC
CLUSTER_NODE_PRIORITY=100
# docker-compose.ymlのcluster-shared CIFSボリュームで使用する。
NAS_CIFS_USERNAME=replace-with-nas-user
NAS_CIFS_PASSWORD=replace-with-nas-password
# Open WebUI自然会話モード。APIキーはOpen WebUI管理画面で発行後に設定する。
OPENWEBUI_API_KEY=
OPENWEBUI_IMAGE_TAG=main
OLLAMA_IMAGE_TAG=latest
# 主系(16GB): qwen3:8b / 待機系(8GB): qwen3:4b
LOCAL_LLM_MODEL=qwen3:8b
# 主系: float16 / 待機系: int8_float16
WHISPER_COMPUTE_TYPE=float16
REALTIME_TTS_VOICE=ja-JP-NanamiNeural
